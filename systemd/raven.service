[Unit]
Description=Raven Tiling Emulator Daemon (Native Rust)
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.kde.raven.Daemon
ExecStart=%h/.local/share/raven/bin/raven_engine
WorkingDirectory=%h/.local/share/raven
Restart=on-failure
RestartSec=2
Slice=session.slice
Nice=2
CPUWeight=100
MemoryHigh=96M
MemoryMax=192M
TasksMax=64
NoNewPrivileges=yes
Environment=RUST_LOG=raven=info

[Install]
WantedBy=graphical-session.target
